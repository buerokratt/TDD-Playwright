{
  "name": "pw",
  "version": "1.0.0",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.16.0"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:test": "cross-env ENV=test npx playwright test",
    "test:test:chromium": "cross-env ENV=test npx playwright test --project=\"*-chromium\"",
    "test:test:firefox": "cross-env ENV=test npx playwright test --project=\"*-firefox\"",
    "test:test:webkit": "cross-env ENV=test npx playwright test --project=\"*-webkit\"",
    "test:stage": "cross-env ENV=stage npx playwright test",
    "test:stage:chromium": "cross-env ENV=stage npx playwright test --project=\"*-chromium\"",
    "test:stage:firefox": "cross-env ENV=stage npx playwright test --project=\"*-firefox\"",
    "test:stage:webkit": "cross-env ENV=stage npx playwright test --project=\"*-webkit\"",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
